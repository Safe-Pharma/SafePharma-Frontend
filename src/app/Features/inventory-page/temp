<div class="py-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- On-Hand Value Card -->
      <div
        class="bg-white rounded-lg border border-gray-200 p-6 hover:shadow-md transition-shadow duration-200"
      >
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">
          On-Hand Value
        </p>
        <div class="flex items-center gap-3">
          <span class="text-3xl font-bold text-gray-900">{{ medicine }}</span>
          <span
            class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200"
          >
            Live
          </span>
        </div>
      </div>

      <!-- Active SKUs Card -->
      <div
        class="bg-white rounded-lg border border-gray-200 p-6 hover:shadow-md transition-shadow duration-200"
      >
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Active SKUs</p>
        <div class="flex items-center gap-3">
          <span class="text-3xl font-bold text-gray-900">{{ stats().activeSKUs }}</span>
          <span
            class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200"
          >
            Live
          </span>
        </div>
      </div>

      <!-- Below Min Stock Card -->
      <div
        class="bg-white rounded-lg border border-gray-200 p-6 hover:shadow-md transition-shadow duration-200"
      >
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">
          Below Min Stock
        </p>
        <div class="flex items-center gap-3">
          <span class="text-3xl font-bold text-gray-900">{{ stats().belowMinStock }}</span>
          <span
            class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-yellow-50 text-yellow-700 border border-yellow-200"
          >
            Live
          </span>
        </div>
      </div>

      <!-- Expiring ≤30D Card -->
      <div
        class="bg-white rounded-lg border border-gray-200 p-6 hover:shadow-md transition-shadow duration-200"
      >
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">
          Expiring ≤30D
        </p>
        <div class="flex items-center gap-3">
          <span class="text-3xl font-bold text-gray-900">{{ stats().expiringSoon }}</span>
          <span
            class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-yellow-50 text-yellow-700 border border-yellow-200"
          >
            Live
          </span>
        </div>
      </div>
    </div>
  </div>